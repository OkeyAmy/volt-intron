# secrets — never commit
.env
.env.*
!.env.example
*.key
*.pem

# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# node
node_modules/
apps/web/dist/

# data: audio is large and consent-bound; manifests and results ARE committed
benchmarks/data/**/audio/
benchmarks/data/afriswitch/
benchmarks/.cache/
fixtures/*.wav
*.sqlite3
*.db
.DS_Store
incoming/

# benchmark downloads — multi-GB, regenerable via  benchmarks.load_data
benchmarks/data/hub_cache/

# user-recorded money briefs (voice = PII) and their derived 16k wavs
benchmarks/data/created/*.m4a
benchmarks/data/created/*.wav
benchmarks/data/created/*.mp3
benchmarks/data/audio/16k/recorded_*.wav

# TTS clips — AI-synthesized, regenerable (costs credits to recreate)
benchmarks/data/sautibench/tts/

# outputs: commit aggregate evidence (report.md, results.json, cost.json) only;
# per-cell transcripts stay local, and the credit cache is local-only
benchmarks/outputs/cache/
benchmarks/outputs/*/per_cell.jsonl

# third-party reference clone (re-clone from source instead of vendoring)
Intron-Multimodal-Benchmarking/

# invoice store (local SQLite) and generated assets
*.db
*.db-wal
*.db-shm
web/.data/

# Track 3 consent-recorder uploads (voice = personal data): never commit audio or zips
benchmarks/data/sautibench/recordings/
benchmarks/data/sautibench/*.zip
