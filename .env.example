# Intron Voice API — https://voice.intron.io/v2/developers
INTRON_API_KEY=your-intron-key-here

# Groq (OpenAI-compatible) — https://console.groq.com/keys
# Benchmark uses whisper-large-v3-turbo regardless of GROQ_MODEL (used by the app).
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=openai/gpt-oss-120b

# Optional benchmark providers
GEMINI_API_KEY=your-gemini-key-here
GEMINI_API_KEY_2=optional-second-key (rotated on 429/quota automatically)
ELEVENLABS_API_KEY=your-elevenlabs-key-here
OPENAI_API_KEY=

# App
DATABASE_URL=sqlite+aiosqlite:///./sautice.db
APP_URL=http://localhost:8000
DEMO_MODE=true
