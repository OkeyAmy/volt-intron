# Intron Voice API — https://voice.intron.io/v2/developers
INTRON_API_KEY=your-intron-key-here

# Groq (OpenAI-compatible) — https://console.groq.com/keys
# Benchmark uses whisper-large-v3-turbo regardless of GROQ_MODEL (used by the app).
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=openai/gpt-oss-120b

# Optional benchmark providers
GEMINI_API_KEY=your-gemini-key-here
GEMINI_API_KEY_2=optional-second-key (rotated on 429/quota automatically)
ELEVENLABS_API_KEY=your-elevenlabs-key-here
OPENAI_API_KEY=

# App
# The web app only uses DATABASE_URL when it is a postgres:// or postgresql:// URL
# (e.g. Neon); leave it empty to use a local SQLite file under web/.data. On Vercel it
# is required. Any other value (like a Python sqlite+aiosqlite:// URL) is ignored.
DATABASE_URL=
APP_URL=http://localhost:8000
DEMO_MODE=true

# Voice transport: "stream" (live, needs the custom server in web/server.mts) or
# "upload" (record then send; works on serverless hosts). Vercel builds default to upload.
# NEXT_PUBLIC_VOICE_TRANSPORT=stream
